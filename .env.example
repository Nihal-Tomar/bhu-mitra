# ==============================================================================
# BhuMitra — Environment Configuration Template
# Department of Land Resources (DoLR), Ministry of Rural Development
# Smart India Hackathon 2026 — Problem Statement 26016
# ==============================================================================

# ─── APPLICATION RUNTIME ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── DATABASE (PostgreSQL + PostGIS) ──────────────────────────────────────────
POSTGRES_USER=bhumitra
POSTGRES_PASSWORD=bhumitra_secure_dev
POSTGRES_DB=bhumitra
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bhumitra:bhumitra_secure_dev@localhost:5432/bhumitra?schema=public

# ─── CACHE & MESSAGE QUEUE (Redis 7) ──────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── OBJECT STORAGE (MinIO S3 Compatible) ─────────────────────────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_ACCESS_KEY=bhumitra_admin
MINIO_SECRET_KEY=bhumitra_minio_secret
MINIO_BUCKET=bhumitra-documents
MINIO_USE_SSL=false

# ─── SECURITY & AUTHENTICATION (JWT) ──────────────────────────────────────────
# Replace with a cryptographically strong 256-bit secret in production
JWT_SECRET=bhumitra_dev_jwt_secret_change_in_production_si2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── INTELLIGENCE & DECISION SUPPORT SERVICE (FastAPI) ────────────────────────
INTELLIGENCE_SERVICE_URL=http://localhost:8000

# ─── FRONTEND CONFIGURATION (Next.js) ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_VERSION=1.0.0-sih
NEXT_PUBLIC_DEMO_MODE=true
