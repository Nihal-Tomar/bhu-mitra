{
  "name": "@bhumitra/web",
  "version": "1.0.0",
  "private": true,
  "description": "BhuMitra Web Application — Next.js Frontend",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "clean": "rimraf .next out"
  },
  "dependencies": {
    "@bhumitra/types": "workspace:*",
    "@bhumitra/ui": "workspace:*",
    "@tanstack/react-query": "^5.80.7",
    "@tanstack/react-query-devtools": "^5.80.7",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.57.0",
    "zod": "^3.25.56",
    "@hookform/resolvers": "^5.0.1"
  },
  "devDependencies": {
    "@bhumitra/config": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.15.29",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4",
    "typescript": "^5.7.3"
  }
}
